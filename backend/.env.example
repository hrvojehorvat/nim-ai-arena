# Copy to backend/.env and run: uv run uvicorn app.main:app --reload --env-file .env
# Leave DATABASE_URL unset to run without a database (matches stay in memory only).
DATABASE_URL=postgresql://nim:nim@localhost:5432/nim_arena
# Seconds an agent waits before playing its move (so humans can follow). 0 = instant.
AGENT_MOVE_DELAY=1.5
